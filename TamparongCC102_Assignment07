#include <iostream>
#include <fstream>
#include <cmath>
using namespace std;

bool isPerfectSquare(int n) {
    if (n < 0) return false;
    int root = sqrt(n);
    return (root * root == n);
}

bool isEven(int n) {
    return n % 2 == 0;
}

